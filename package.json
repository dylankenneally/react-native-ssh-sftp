{
  "name": "@dylankenneally/react-native-ssh-sftp",
  "version": "1.10.2",
  "description": "SSH and SFTP client library for React Native",
  "main": "lib/sshclient.js",
  "scripts": {
    "_postinstall": "npm run compile",
    "prepare": "husky",
    "build": "npm run compile && npm pack",
    "precompile": "npm run lint:build",
    "compile": "npx tsc",
    "lint": "eslint .",
    "lint:build": "cross-env NODE_ENV=production npm run lint -- --max-warnings 20",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:integration": "node --test test/integration/smoke.test.mjs",
    "test:integration:local": "docker compose -f test/integration/docker-compose.yml up -d && npm run test:integration; status=$?; docker compose -f test/integration/docker-compose.yml down; exit $status",
    "docs": "cd docs && mint dev"
  },
  "keywords": [
    "react-native",
    "ssh",
    "sftp"
  ],
  "homepage": "https://github.com/dylankenneally/react-native-ssh-sftp#readme",
  "bugs": {
    "url": "https://github.com/dylankenneally/react-native-ssh-sftp/issues",
    "email": "project@hostname.com"
  },
  "author": {
    "name": "Dylan Kenneally",
    "email": "github@dylankenneally.com",
    "url": "https://github.com/dylankenneally/react-native-ssh-sftp"
  },
  "contributors": [
    {
      "name": "Emmanuel Natividad",
      "url": "https://github.com/enatividad/react-native-ssh-sftp"
    },
    {
      "name": "Gabriel Paul \"Cley Faye\" Risterucci",
      "email": "gabriel@keeex.net",
      "url": "https://github.com/KeeeX/react-native-ssh-sftp"
    },
    {
      "name": "Bishoy Mikhae",
      "url": "https://github.com/MrBmikhael/react-native-ssh-sftp"
    },
    {
      "name": "Qian Sha",
      "email": "x_ash@qq.com",
      "url": "https://github.com/shaqian/react-native-ssh-sftp"
    }
  ],
  "license": "MIT",
  "peerDependencies": {
    "react-native": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylankenneally/react-native-ssh-sftp.git"
  },
  "files": [
    "android/",
    "ios/",
    "lib/",
    "RNSSHClient.podspec"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "mint": "^4.2.651",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "npm": ">=10.5.1",
    "node": ">=22.0.0"
  }
}
